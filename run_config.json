{
  "table_path": "data/table.xlsx",
  "schema_sheet_name": "schema",
  "schema_mode": "sheet",
  "pdf_folder": "data/pdfs",
  "title_col": "Title",
  "authors_col": "Authors",
  "year_col": "Publication Year",
  "treat_single_space_as_empty": true,
  "verify_mode": false,
  "fast_mode": false,
  "max_success_mode": true,
  "provider": {
    "mode": "openai",
    "base_url": "http://localhost:1234/v1",
    "api_key": null,
    "model_header": "gpt-oss-20b",
    "model_match": "gpt-oss-20b",
    "model_extract": "gpt-oss-20b",
    "model_query_helper": "gpt-oss-20b",
    "max_prompt_chars": 26000,
    "mock_mode": false,
    "mock_payloads_path": null
  },
  "matching": {
    "top_k": 10,
    "confidence_threshold": 0.75,
    "confidence_margin": 0.05,
    "year_tolerance": 1,
    "header_max_chars": 8000
  },
  "extraction": {
    "groups": [],
    "examples_per_col": 3,
    "max_chunks": 20,
    "retry_on_unclear": true,
    "retry_extra_chunks": 10
  },
  "retrieval": {
    "top_k": 20,
    "rerank_k": 20,
    "max_context_chunks": 24,
    "max_context_tokens": 2400,
    "query_variants": 6,
    "use_query_expansion": true,
    "use_hyde": true,
    "rrf_k": 60,
    "embedding_backend": "lmstudio",
    "embedding_model": "text-embedding-nomic-embed-text-v1.5-embedding",
    "reranker_backend": "lmstudio",
    "reranker_model": "bge-small-en-v1.5-gguf",
    "use_reranker": true
  },
  "ocr": {
    "enable_ocr": true,
    "ocr_trigger_min_chars_per_page": 400
  },
  "grobid": {
    "enable_grobid": false,
    "server_url": "http://localhost:8070",
    "parse_references": false
  },
  "output": {
    "debug_reports": false
  },
  "max_workers": 1
}
