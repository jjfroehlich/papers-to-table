{"proposal_id": "prop_run_20260405_180401_9anyxv_cell_28df0f22dc3a_1775413636622", "run_id": "run_20260405_180401_9anyxv", "pdf_id": "paper_2", "row_id": "row_d02cb42d72a4", "column_name": "Model system", "cell_id": "cell_28df0f22dc3a", "state": "error", "support": "error", "proposed_value": null, "rationale": "Provider error: LM Studio returned malformed JSON after bounded recovery: ", "calculation": null, "primary_evidence_id": null, "ordered_supporting_evidence_ids": [], "evidence_ids": [], "warning_flags": ["provider_error"], "needs_more_evidence": false, "is_verify_mode": true, "existing_value": "K562 ", "field_type": null, "allowed_values": null, "numeric_value_form": null, "recall_rescue_used": false, "whole_document_used": false, "provider_mode": "live_local", "run_mode": "verify", "prompt_version": null, "prompt_hash": "03c1f8d95e6ab5ba996d96b40750e440d3a819f0ad1faca4c90d447321905795", "schema_hash": "cb85a287e0071d47941d9619dce7cc4484246fbb22ff0b3f6ec6843296a82ff7", "schema_version": null, "config_hash": "d84332aeedfea09c294f3266f16b8d9d485ab43f0946dcfd2d30ef2265768f06", "config_snapshot_path": "config.snapshot.json", "parser_identity": "docling", "parser_version": null, "text_model_id": "qwen/qwen3.5-9b", "vision_model_id": "qwen/qwen3.5-9b", "gold_table_source_reference": null, "gold_table_hash": null, "gold_table_snapshot_path": null, "masked_working_table_path": null, "masked_working_table_hash": null, "vision_trigger_reasons": [], "vision_shortlist": null, "created_at": "2026-04-05T18:27:16.622183+00:00"}
{"proposal_id": "prop_run_20260405_180401_9anyxv_cell_b966a213c7f5_1775413671613", "run_id": "run_20260405_180401_9anyxv", "pdf_id": "paper_2", "row_id": "row_d02cb42d72a4", "column_name": "Abstract", "cell_id": "cell_b966a213c7f5", "state": "error", "support": "error", "proposed_value": null, "rationale": "Provider error: LM Studio returned malformed JSON after bounded recovery: ", "calculation": null, "primary_evidence_id": null, "ordered_supporting_evidence_ids": [], "evidence_ids": [], "warning_flags": ["provider_error"], "needs_more_evidence": false, "is_verify_mode": true, "existing_value": "Gene regulation in the human genome is controlled by distal enhancers that activate specific nearby promoters1. One model for this specificity is that promoters might have sequence-encoded preferences for certain enhancers, for example mediated by interacting sets of transcription factors or cofactors2. This â€œbiochemical compatibilityâ€ model has been supported by observations at individual human promoters and by genome-wide measurements in Drosophila3â€“9. However, the degree to which human enhancers and promoters are intrinsically compatible has not been systematically measured, and how their activities combine to control RNA expression remains unclear. Here we designed a high-throughput reporter assay called ExP STARR-seq (enhancer x promoter self-transcribing active regulatory region sequencing) and applied it to examine the combinatorial compatibilities of 1,000 enhancer and 1,000 promoter sequences in human K562 cells. We identify simple rules for enhancer-promoter compatibility: most enhancers activated all promoters by similar amounts, and intrinsic enhancer and promoter activities combine multiplicatively to determine RNA output (R2=0.82). In addition, two classes of enhancers and promoters showed subtle preferential effects. Promoters of housekeeping genes contained built-in activating motifs for factors such as GABPA and YY1, which decreased the responsiveness of promoters to distal enhancers. Promoters of variably expressed genes lacked these motifs and showed stronger responsiveness to enhancers. Together, this systematic assessment of enhancer-promoter compatibility suggests a multiplicative model tuned by enhancer and promoter class to control gene transcription in the human genome.", "field_type": null, "allowed_values": null, "numeric_value_form": null, "recall_rescue_used": false, "whole_document_used": false, "provider_mode": "live_local", "run_mode": "verify", "prompt_version": null, "prompt_hash": "03c1f8d95e6ab5ba996d96b40750e440d3a819f0ad1faca4c90d447321905795", "schema_hash": "cb85a287e0071d47941d9619dce7cc4484246fbb22ff0b3f6ec6843296a82ff7", "schema_version": null, "config_hash": "d84332aeedfea09c294f3266f16b8d9d485ab43f0946dcfd2d30ef2265768f06", "config_snapshot_path": "config.snapshot.json", "parser_identity": "docling", "parser_version": null, "text_model_id": "qwen/qwen3.5-9b", "vision_model_id": "qwen/qwen3.5-9b", "gold_table_source_reference": null, "gold_table_hash": null, "gold_table_snapshot_path": null, "masked_working_table_path": null, "masked_working_table_hash": null, "vision_trigger_reasons": [], "vision_shortlist": null, "created_at": "2026-04-05T18:27:51.613853+00:00"}
