{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "papers-to-table agent kit review_data.json",
  "type": "object",
  "required": ["schema_version", "run_id", "items"],
  "properties": {
    "schema_version": {"type": "string"},
    "run_id": {"type": "string"},
    "generated_at": {"type": "string"},
    "coverage": {"type": "object"},
    "columns": {"type": "array", "items": {"type": "object"}},
    "rows": {"type": "array", "items": {"type": "object"}},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["proposal_id", "row_id", "column_name", "proposed_value"],
        "properties": {
          "proposal_id": {"type": "string"},
          "cell_id": {"type": "string"},
          "row_id": {"type": "string"},
          "row_index": {"type": ["integer", "null"]},
          "row_label": {"type": ["string", "null"]},
          "column_name": {"type": "string"},
          "proposed_value": {},
          "rationale": {"type": ["string", "null"]},
          "evidence": {"type": "array", "items": {"type": "object"}},
          "confidence": {"type": ["string", "number", "null"]},
          "needs_review": {"type": "boolean"},
          "caveat": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
