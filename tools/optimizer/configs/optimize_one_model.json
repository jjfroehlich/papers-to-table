        "filled_on_gold_empty_count": "filled_on_gold_empty_count"
      }
    }
  },
  "acceptance": {
    "primary_metric": "content_correctness",
    "min_improvement": 0.01,
    "degraded_score_policy": "disallow",
    "tie_break": {
      "epsilon": 0.002,
      "secondary_objectives": [
        {
          "metric": "evidence_quality",
          "direction": "max",
          "min_improvement": 0.0
        },
        {
          "metric": "judge_disagreement",
          "direction": "min",
          "min_improvement": 0.0
        },
        {
          "metric": "failure_count",
          "direction": "min",
          "min_improvement": 0.0
        },
        {
          "metric": "null_count",
          "direction": "min",
          "min_improvement": 0.0
        },
        {
          "metric": "runtime_seconds",
          "direction": "min",
          "min_improvement": 5.0
        }
      ]
    },
    "guardrails": {
      "evidence_quality": {
        "min": 0.85
      },
      "null_count": {
        "max": 5,
        "max_delta": 1
      },
      "failure_count": {
        "max": 0
      }
    }
  },
  "optimize": {
    "rounds": 6,
    "batch_size": 4
  },
  "compare": {
    "holdout_top_k": 0,
    "require_structured_output_for_extraction": true,
    "allow_degraded_candidates": false
  }
