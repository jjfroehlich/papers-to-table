{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "proposals.jsonl record",
  "type": "object",
  "required": [
    "proposal_id",
    "run_id",
    "row_id",
    "column_name",
    "cell_id",
    "proposal_status",
    "evidence_status",
    "review_bucket",
    "reason_codes",
    "evidence_ids"
  ],
  "properties": {
    "proposal_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "row_id": {
      "type": "string"
    },
    "column_name": {
      "type": "string"
    },
    "cell_id": {
      "type": "string"
    },
    "proposal_status": {
      "type": "string",
      "enum": [
        "value_proposed",
        "no_data",
        "unresolved",
        "not_applicable",
        "not_attempted",
        "error"
      ]
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "direct_strong",
        "direct_weak",
        "inferred_strong",
        "inferred_weak",
        "no_evidence",
        "not_applicable"
      ]
    },
    "review_bucket": {
      "type": "string",
      "enum": [
        "review",
        "attention",
        "diagnostic"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposed_value": {},
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_answers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "value": {},
          "candidate_status": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "first_pass_text",
              "rescued_text",
              "evidence_recovery",
              "figure_review"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence_rationale": {},
          "warning_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "candidate_id",
          "candidate_status",
          "source",
          "evidence_ids"
        ],
        "additionalProperties": true
      }
    },
    "selection_diagnostics": {
      "type": [
        "object",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
